# 根目录环境变量（pnpm db:sync-env 会同步到 Data-API-Service/.env）

# MySQL（Docker：pnpm db:up）
MYSQL_DB_USER=root
MYSQL_DB_PWD=123456
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=media_crawler
MYSQL_HOST_PORT=3306

# 内部 API 鉴权 Token（Data-API ← → Crawler 服务间通信）
# 生产环境必须修改为强随机值
INTERNAL_API_TOKEN=internal-dev-token

# 签名服务不可用时是否立即失败（生产建议 true）
SIGNER_FAIL_FAST=false
